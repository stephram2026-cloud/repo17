+beforeEach(async () => {
+  await global.emptyDatabase()();
+  await loadMappings();
+  await loadRules();
+  // A Wednesday, so a pattern built from today's weekday can't
+  // accidentally match the Monday transactions below.
+  MockDate.set(new Date(2024, 10, 6));
+});
+
+afterEach(() => {
+  MockDate.reset();
+});
+
+async function insertPayments(accountId: string, dates: string[]) {
+  await db.insertAccount({ id: accountId, name: accountId });
+  const payee = await db.insertPayee({ name: 'Payee ' + accountId });
+  for (const date of dates) {
+    await db.insertTransaction({
+      account: accountId,
+      payee,
+      date,
+      amount: -5000,
+    });
+  }
+}
+
+describe('findSchedules', () => {
+  test('finds a schedule on the 1st and 3rd Monday of the month', async () => {
+    await insertPayments('acct1', [
+      '2024-07-01',
+      '2024-07-15',
