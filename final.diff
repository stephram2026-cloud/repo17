+++ b/packages/loot-core/src/server/accounts/opening-balances.ts
@@ -0,0 +1,119 @@
+import * as db from '#server/db';
+import { fromDateRepr } from '#server/models';
+
+import { stableId } from './stable-ids';
+
+/**
+ * What the id of the opening balance that bank sync adds when it links an
+ * account is made of: the account, and the date and amount of the balance.
+ */
+export function openingBalanceIdParts(
+  accountId: string,
+  date: string,
+  amount: number,
+) {
+  return ['opening-balance', accountId, date, amount] as const;
+}
+
+function isUntouchedBankSyncOpeningBalance(row: OpeningBalanceRow) {
+  const date = fromDateRepr(row.date);
+  return (
+    row.id === stableId(...openingBalanceIdParts(row.account, date, row.amount))
+  );
+}
+
+type OpeningBalanceRow = {
+  id: string;
+  account: string;
+  accountName: string;
+  date: number;
+  amount: number;
+};
+
+export type OpeningBalanceConflict = {
+  accountName: string;
+  /** The opening balance that stays: the earliest one */
+  date: string;
+  amount: number;
+  /** The other one */
+  otherDate: string;
+  otherAmount: number;
+  /** What the other one should be: the earliest plus the transactions up to it */
+  expectedAmount: number;
+  /** Whether the other one was removed (only untouched bank-sync ones are) */
+  removed: boolean;
+};
+
+/**
+ * Make sure an account has only one opening balance after two devices both
+ * linked it to the bank before syncing with each other.
+ *
+ * Linked on different days, the devices see different 90-day windows of
+ * transactions, so each works out a different opening balance (date and
+ * amount) and both arrive here. After syncing the account has the
+ * transactions of both windows, so only the earliest opening balance is
+ * right; a later one counts the transactions in between a second time. The
+ * later one is removed, but only if bank sync added it and nobody has
+ * changed it since.
+ *
+ * Nothing is lost when the later figure equals the earliest one plus the
+ * transactions in between. Otherwise, or when a later opening balance can't
+ * be removed, it is returned so that it can be reported.
+ */
+export async function resolveOpeningBalances(): Promise<
+  OpeningBalanceConflict[]
+> {
+  const rows = await db.all<OpeningBalanceRow>(
+    `SELECT t.id, t.account, a.name AS accountName, t.date, t.amount
+       FROM v_transactions_internal_alive t
+       JOIN accounts a ON a.id = t.account
+      WHERE t.starting_balance_flag = 1 AND t.is_child = 0
+        AND t.account IN (
+          SELECT account FROM v_transactions_internal_alive
+           WHERE starting_balance_flag = 1 AND is_child = 0
+           GROUP BY account HAVING COUNT(*) > 1
+        )
+      ORDER BY t.account, t.date, t.id`,
+  );
+
+  const byAccount = new Map<string, OpeningBalanceRow[]>();
+  for (const row of rows) {
+    byAccount.set(row.account, [...(byAccount.get(row.account) ?? []), row]);
+  }
+
+  const conflicts: OpeningBalanceConflict[] = [];
+  for (const [earliest, ...others] of byAccount.values()) {
+    // Only accounts where bank sync added one: the others are someone's own
+    // figures
+    if (![earliest, ...others].some(isUntouchedBankSyncOpeningBalance)) {
+      continue;
+    }
+    for (const other of others) {
+      const sum = await db.first<{ total: number }>(
+        `SELECT COALESCE(SUM(amount), 0) AS total
+           FROM v_transactions_internal_alive
+          WHERE account = ? AND is_parent = 0
+            AND (starting_balance_flag IS NULL OR starting_balance_flag = 0)
+            AND date >= ? AND date < ?`,
+        [earliest.account, earliest.date, other.date],
+      );
+      const expectedAmount = earliest.amount + (sum?.total ?? 0);
+      const removed = isUntouchedBankSyncOpeningBalance(other);
+      if (removed) {
+        await db.deleteTransaction({ id: other.id });
+      }
+      if (!removed || other.amount !== expectedAmount) {
+        conflicts.push({
+          accountName: earliest.accountName,
+          date: fromDateRepr(earliest.date),
+          amount: earliest.amount,
+          otherDate: fromDateRepr(other.date),
+          otherAmount: other.amount,
+          expectedAmount,
+          removed,
+        });
+      }
+    }
+  }
+  return conflicts;
+}
