+  });
+});
diff --git a/packages/loot-core/src/server/transactions/duplicate-imports.ts b/packages/loot-core/src/server/transactions/duplicate-imports.ts
new file mode 100644
index 000000000..e00d2eef0
--- /dev/null
+++ b/packages/loot-core/src/server/transactions/duplicate-imports.ts
@@ -0,0 +1,45 @@
+import * as db from '#server/db';
+import { fromDateRepr } from '#server/models';
+
+export type DuplicateImport = {
+  accountName: string;
+  importedId: string;
+  count: number;
+  date: string;
+  amount: number;
+};
+
+/**
+ * Find bank transactions that exist more than once in the same account: two
+ * live rows sharing one bank id are always the same real transaction.
+ *
+ * Importing the same data on two devices no longer creates these, but they
+ * can still come from older data, or from a manual entry made on one device
+ * just before the other imported its bank transaction. They are reported,
+ * not merged, so that nobody's edits to either copy are dropped silently.
+ */
+export async function findDuplicateImports(): Promise<DuplicateImport[]> {
+  const rows = await db.all<{
+    account_name: string;
+    imported_id: string;
+    count: number;
+    date: number;
+    amount: number;
+  }>(
+    `SELECT a.name AS account_name, t.imported_id, COUNT(*) AS count,
+            MIN(t.date) AS date, MIN(t.amount) AS amount
+       FROM v_transactions_internal_alive t
+       LEFT JOIN accounts a ON a.id = t.account
+      WHERE t.imported_id IS NOT NULL AND t.imported_id != ''
+      GROUP BY t.account, t.imported_id
+     HAVING COUNT(*) > 1
+      ORDER BY date DESC`,
+  );
+  return rows.map(row => ({
+    accountName: row.account_name,
+    importedId: row.imported_id,
+    count: row.count,
+    date: fromDateRepr(row.date),
+    amount: row.amount,
+  }));
+}
