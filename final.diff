@@ -0,0 +1,145 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import * as db from '#server/db';
+
+import { mergeTransactions } from './merge';
+import { alignSplitLines } from './split-lines';
+
+import { batchUpdateTransactions } from './index';
+
+beforeEach(global.emptyDatabase());
+
+async function setup() {
+  await db.insertAccount({ id: 'one', name: 'one' });
+  await db.insertAccount({ id: 'two', name: 'two' });
+  await db.insertPayee({ id: 'transfer-one', name: '', transfer_acct: 'one' });
+  await db.insertPayee({ id: 'transfer-two', name: '', transfer_acct: 'two' });
+  await db.insertAccount({ id: 'three', name: 'three' });
+  await db.insertPayee({
+    id: 'transfer-three',
+    name: '',
+    transfer_acct: 'three',
+  });
+
+  await batchUpdateTransactions({
+    added: [
+      {
+        id: 'parent',
+        account: 'one',
+        amount: -100,
+        date: '2024-01-31',
+        is_parent: true,
+      },
+      {
+        id: 'line1',
+        account: 'one',
+        amount: -60,
+        date: '2024-01-31',
+        is_child: true,
+        parent_id: 'parent',
+      },
+      {
+        id: 'line2',
+        account: 'one',
+        amount: -40,
+        date: '2024-01-31',
+        is_child: true,
+        parent_id: 'parent',
+        payee: 'transfer-three',
+      },
+    ],
+  });
+}
+
+function getLines() {
+  return db.all<{ id: string; date: number; account: string }>(
+    `SELECT id, date, account FROM v_transactions_internal
+      WHERE parent_id = 'parent' AND tombstone = 0 ORDER BY id`,
+  );
+}
+
+describe('split lines stay with their parent', () => {
+  it('moves the lines when only the parent date is changed', async () => {
+    await setup();
+
+    // What a rule setting the date, or bank sync updating dates, sends
+    await batchUpdateTransactions({
+      updated: [{ id: 'parent', date: '2024-02-01' }],
+    });
+
+    expect(await getLines()).toEqual([
+      { id: 'line1', date: 20240201, account: 'one' },
+      { id: 'line2', date: 20240201, account: 'one' },
+    ]);
+  });
+
+  it('puts a line back when only the line date is changed', async () => {
+    await setup();
+
+    await batchUpdateTransactions({
+      updated: [{ id: 'line1', date: '2024-02-01' }],
+    });
+
+    expect(await getLines()).toEqual([
+      { id: 'line1', date: 20240131, account: 'one' },
+      { id: 'line2', date: 20240131, account: 'one' },
+    ]);
+  });
+
+  it('moves the lines, and the transfer on a line, with the parent account', async () => {
+    await setup();
+
+    await batchUpdateTransactions({
+      updated: [{ id: 'parent', account: 'two' }],
+    });
+
+    expect(await getLines()).toEqual([
+      { id: 'line1', date: 20240131, account: 'two' },
+      { id: 'line2', date: 20240131, account: 'two' },
+    ]);
+    // The other side of the transfer line now comes from account two
+    const line2 = await db.getTransaction('line2');
+    const counterpart = await db.getTransaction(line2.transfer_id);
+    expect(counterpart.account).toBe('three');
+    expect(counterpart.payee).toBe('transfer-two');
+  });
+
+  it('gives lines moved by a merge the kept transaction date', async () => {
+    await setup();
+    // An imported duplicate a day later: merge keeps it and takes the lines
+    await db.insertTransaction({
+      id: 'imported',
+      account: 'one',
+      amount: -100,
+      date: '2024-02-01',
+      imported_id: 'bank-1',
+    });
+
+    expect(
+      await mergeTransactions([{ id: 'parent' }, { id: 'imported' }]),
+    ).toBe('imported');
+
+    const lines = await db.all<{ id: string; date: number }>(
+      `SELECT id, date FROM v_transactions_internal
+        WHERE parent_id = 'imported' AND tombstone = 0 ORDER BY id`,
+    );
+    expect(lines).toEqual([
+      { id: 'line1', date: 20240201 },
+      { id: 'line2', date: 20240201 },
+    ]);
+  });
+
+  it('repairs lines that were left on another date', async () => {
+    await setup();
+    // Bypass the batch update, as data from an older version or another
+    // device can arrive
+    await db.updateTransaction({ id: 'line1', date: '2023-12-15' });
+
+    expect(await alignSplitLines()).toEqual(['line1']);
+    expect(await getLines()).toEqual([
+      { id: 'line1', date: 20240131, account: 'one' },
+      { id: 'line2', date: 20240131, account: 'one' },
+    ]);
+    expect(await alignSplitLines()).toEqual([]);
+  });
+});
