@@ -0,0 +1,57 @@
+import * as db from '#server/db';
+import { whereIn } from '#server/db/util';
+import { fromDateRepr } from '#server/models';
+
+/**
+ * Put every line of a split back on its parent's date and account.
+ *
+ * A split is one transaction, so its lines must always share the parent's
+ * date and account; otherwise a line can be counted in a different month
+ * or account than the rest of the split. Anything that moves only the
+ * parent or only a line (a rule setting the date, bank sync updating dates,
+ * a merge, an edit on another device) is corrected here, and the parent
+ * always wins.
+ *
+ * Pass the parent ids to check, or nothing to check every split. Returns the
+ * ids of the lines that were moved.
+ */
+export async function alignSplitLines(parentIds?: string[]): Promise<string[]> {
+  if (parentIds && parentIds.length === 0) {
+    return [];
+  }
+
+  const rows = await db.all<{ id: string; date: number; account: string }>(
+    `SELECT c.id, p.date, p.account
+       FROM v_transactions_internal_alive c
+       JOIN v_transactions_internal_alive p ON p.id = c.parent_id
+      WHERE c.is_child = 1 AND p.is_parent = 1
+        AND (c.date != p.date OR c.account != p.account)
+        ${parentIds ? 'AND ' + whereIn(parentIds, 'p.id') : ''}`,
+  );
+
+  for (const row of rows) {
+    await db.updateTransaction({
+      id: row.id,
+      date: fromDateRepr(row.date),
+      account: row.account,
+    });
+  }
+
+  return rows.map(row => row.id);
+}
+
+/**
+ * The parents of the splits that the given transactions belong to (a
+ * parent maps to itself, a line to its parent).
+ */
+export async function getSplitParentIds(ids: string[]): Promise<string[]> {
+  if (ids.length === 0) {
+    return [];
+  }
+  const rows = await db.all<{ parent: string }>(
+    `SELECT DISTINCT CASE WHEN is_child = 1 THEN parent_id ELSE id END AS parent
+       FROM v_transactions_internal
+      WHERE (is_parent = 1 OR is_child = 1) AND ${whereIn(ids, 'id')}`,
+  );
+  return rows.map(row => row.parent).filter(Boolean);
+}
