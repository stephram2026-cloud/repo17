new file mode 100644
index 000000000..fd8d55be6
--- /dev/null
+++ b/packages/loot-core/src/server/accounts/stable-ids.ts
@@ -0,0 +1,91 @@
+import { v4 as uuidv4, v5 as uuidv5 } from 'uuid';
+
+import * as db from '#server/db';
+
+// Namespace for ids derived from what a row represents (see `stableId`)
+const NAMESPACE = 'b1f3c7d2-5e8a-4c6b-9f0d-2a7e4b8c1d35';
+
+/**
+ * An id derived from what a row represents rather than a random one.
+ *
+ * When two devices import the same bank account or file before syncing with
+ * each other, random ids turn every transaction (and its payee, opening
+ * balance, split lines and transfer) into two rows once they sync. With the
+ * same id on both devices they are the same row, and sync merges the two
+ * writes field by field like any other edit.
+ */
+export function stableId(...parts: Array<string | number | null | undefined>) {
+  return uuidv5(JSON.stringify(parts.map(part => part ?? null)), NAMESPACE);
+}
+
+/**
+ * `stableId`, unless a row with that id already exists in `table` (for
+ * example one that was deleted or merged away): then a random id, so an old
+ * row is never brought back or written over.
+ */
+export async function unusedStableId(
+  table: 'transactions' | 'payees',
+  ...parts: Array<string | number | null | undefined>
+): Promise<string> {
+  const id = stableId(...parts);
+  const existing = await db.first<{ id: string }>(
+    `SELECT id FROM ${table} WHERE id = ?`,
+    [id],
+  );
+  return existing ? uuidv4() : id;
+}
+
+type ImportedTransaction = {
+  imported_id?: string | null;
+  date?: string | null;
+  amount?: number | null;
+  imported_payee?: string | null;
+  notes?: string | null;
+};
+
+/**
+ * Ids for transactions about to be created from imported data (bank sync or
+ * a file), in import order.
+ *
+ * A bank id identifies the transaction on its own. Without one (CSV, QIF)
+ * the date, amount, bank payee and notes do, counting repeats within the
+ * import so that two identical transactions on the same day stay two.
+ */
+export async function importedTransactionIds(
+  accountId: string,
+  transactions: ImportedTransaction[],
+): Promise<string[]> {
+  const seen = new Map<string, number>();
+  const ids: string[] = [];
+  for (const trans of transactions) {
+    if (trans.imported_id) {
+      ids.push(
+        await unusedStableId(
+          'transactions',
+          'imported',
+          accountId,
+          trans.imported_id,
+        ),
+      );
+      continue;
+    }
+    const content = JSON.stringify([
+      trans.date,
+      trans.amount,
+      trans.imported_payee,
+      trans.notes,
+    ]);
+    const occurrence = seen.get(content) ?? 0;
+    seen.set(content, occurrence + 1);
+    ids.push(
+      await unusedStableId(
+        'transactions',
+        'imported-content',
+        accountId,
+        content,
+        occurrence,
+      ),
+    );
+  }
+  return ids;
+}
