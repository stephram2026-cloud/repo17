+  await db.insertTransaction({
+    id: 'tesco',
+    account: 'one',
+    amount: -1250,
+    date: '2026-11-02',
+  });
+  await db.insertTransaction({
+    id: 'salary',
+    account: 'one',
+    amount: 250000,
+    date: '2026-11-05',
+  });
+}
+
+function openingBalances() {
+  return db.all<{ date: number; amount: number }>(
+    `SELECT date, amount FROM v_transactions_internal_alive
+      WHERE starting_balance_flag = 1 ORDER BY date`,
+  );
+}
+
+async function balance() {
+  const sum = await db.first<{ total: number }>(
+    `SELECT SUM(amount) AS total FROM v_transactions_internal_alive
+      WHERE account = 'one' AND is_parent = 0`,
